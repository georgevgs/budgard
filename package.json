{
  "name": "expense-tracker",
  "private": true,
  "version": "2.10.0",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "typecheck": "tsc -b",
    "edge:lock": "node scripts/edgeDependencies.mjs lock",
    "edge:check": "node scripts/edgeDependencies.mjs check",
    "audit:edges": "node scripts/edgeDependencies.mjs audit",
    "audit:npm": "bun scripts/auditDependencies.mjs",
    "audit:dependencies": "npm run audit:npm && npm run audit:edges",
    "knip": "knip",
    "knip:production": "knip --production",
    "audit:api": "node scripts/auditApiUsage.mjs",
    "backup:monitor:install": "node scripts/installBackupMonitoring.mjs --install",
    "usage:report": "supabase db query --remote --output json --file docs/product-usage-query.sql",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "budget": "node scripts/bundleBudget.mjs",
    "brand:generate": "zsh design/brand/generate-assets.zsh",
    "sync:agents": "node scripts/syncAgentDocs.ts",
    "docs:schema": "node scripts/generateSchemaMap.mjs",
    "backup": "node scripts/backup.mjs",
    "backup:verify": "node scripts/backup/verify.mjs",
    "backup:health": "node scripts/backupHealth.mjs",
    "test:backup": "node --test scripts/backup/*.test.mjs",
    "test:audit": "node --test scripts/audit/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.3",
    "@marsidev/react-turnstile": "^1.6.3",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@sentry/react": "^10.78.0",
    "@supabase/supabase-js": "2.119.0",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "i18next": "^26.7.1",
    "i18next-browser-languagedetector": "^8.3.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.69.0",
    "pdfmake": "^0.3.13",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.12",
    "react-router-dom": "^7.18.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "7.0.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "nanoid": "3.3.18"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@sentry/vite-plugin": "^5.4.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "deno": "2.9.6",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "knip": "6.44.2",
    "netlify-purge-cloudflare-on-deploy": "1.2.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "supabase": "3.0.0",
    "tailwindcss": "^4.3.4",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-window": "^7.4.1"
  }
}
