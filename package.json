    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "netlify-purge-cloudflare-on-deploy": "1.2.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "supabase": "2.116.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0",
    "workbox-window": "^7.4.1"
