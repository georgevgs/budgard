{
  "name": "expense-tracker",
  "private": true,
  "version": "2.7.6",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "typecheck": "tsc -b",
    "edge:lock": "node scripts/edgeDependencies.mjs lock",
    "edge:check": "node scripts/edgeDependencies.mjs check",
    "audit:edges": "node scripts/edgeDependencies.mjs audit",
    "audit:dependencies": "bun audit && npm run audit:edges",
    "knip": "npx --yes knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "budget": "node scripts/bundleBudget.mjs",
    "brand:generate": "zsh design/brand/generate-assets.zsh",
    "sync:agents": "node scripts/syncAgentDocs.ts",
    "docs:schema": "node scripts/generateSchemaMap.mjs",
    "backup": "node scripts/backup.mjs",
    "backup:verify": "node scripts/backup/verify.mjs",
    "test:backup": "node --test scripts/backup/backup.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@marsidev/react-turnstile": "^1.6.1",
