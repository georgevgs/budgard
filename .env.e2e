# Hermetic end-to-end run. The Supabase host is a placeholder that never
# resolves — every request to it is intercepted by the Playwright mock in
# e2e/fixtures/mockSupabase.ts, so the suite needs no live project, no test
# account and no network.
VITE_SUPABASE_URL=https://e2e.supabase.co
VITE_SUPABASE_ANON_KEY=e2e-anon-key
# Cloudflare's documented always-passes test key, so the auth form's widget
# resolves without reaching challenges.cloudflare.com.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
